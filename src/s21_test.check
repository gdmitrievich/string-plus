#include <stdio.h>
#include <string.h>

#include "s21_string.h"

#test test_s21_memchr

char str[] =
    "- Good morning! Help me please! \0 joke by aatroxiv, lenwoodr, licoricg, "
    "vinephil, livardce \n";
char ch[] = {'-', 'H', 'l', 'p', '\n'};
int num[] = {2, 4, 20, 40, 100};

for (int i = 0; i < 5; i++) {
  ck_assert_ptr_eq(s21_memchr(str, ch[i], num[i]), memchr(str, ch[i], num[i]));

  printf("***debug --->  s21_memchr(str, ch[i], num[i]) = %p, i = %d\n",
         memchr(str, ch[i], num[i]), i);
}

#test test_s21_memcmp

char str[][30] = {
    "aatroxiv", "aatrox1v", "_aatroxiv", "aatroxi", "aatroxiv_1",
};
int num[] = {2, 4, 20, 40, 0};

for (int i = 0; i < 5; i++) {
  ck_assert_int_eq(s21_memcmp(str[0], str[i], num[i]),
                   memcmp(str[0], str[i], num[i]));
  printf("***debug --->  s21_memcmp(str[0], str[i], num[i]) = %d, i = %d\n",
         s21_memcmp(str[0], str[i], num[i]), i);
}

#test test_s21_memcpy

char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
int num[] = {2, 4, 20, 30, 0};

for (int i = 0; i < 4; i++) {
  ck_assert_mem_eq(s21_memcpy(str[i], str[i + 1], num[i]),
                   memcpy(str[i], str[i + 1], num[i]), 30);
  printf("***debug --->  s21_memcpy(str[i], str[i+1], num[i]) = %p, i = %d\n",
         s21_memcpy(str[i], str[i + 1], num[i]), i);
}

#test test_s21_memset

char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
char ch[] = {'-', 'H', 'l', 'p', '\n'};
int num[] = {2, 4, 20, 30, 0};

for (int i = 0; i < 5; i++) {
  ck_assert_mem_eq(s21_memset(str[i], ch[i], num[i]),
                   memset(str[i], ch[i], num[i]), 30);

  printf(
      "***debug --->  s21_memset(str[i], ch[i], num[i]) = %p, i = %d, str = "
      "%s\n",
      s21_memset(str[i], ch[i], num[i]), i, str[i]);
}

#test test_s21_strncat

char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
int num[] = {2, 4, 20, 0, 0};

for (int i = 0; i < 4; i++) {
  ck_assert_mem_eq(s21_strncat(str[i], str[i + 1], num[i]),
                   strncat(str[i], str[i + 1], num[i]), 30);

  printf(
      "***debug --->  s21_strncat(str[i], str[i+1], num[i]) = %p, i = %d, str "
      "= "
      "%s\n",
      s21_strncat(str[i], str[i + 1], num[i]), i, str[i]);
}

#test test_s21_strchr

char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
char ch[] = {'\0', 'H', 'l', 'p', '\t'};

for (int i = 0; i < 5; i++) {
  ck_assert_ptr_eq(s21_strchr(str[i], ch[i]), strchr(str[i], ch[i]));

  printf(
      "***debug --->  s21_strchr(str[i], ch[i]) = %p, i = %d, ch= %c, str = "
      "%s\n",
      s21_strchr(str[i], ch[i]), i, ch[i], s21_strchr(str[i], ch[i]));
}

#test test_s21_strncmp

char str[][30] = {
    "aatroxiv", "aatrox1v", "_aatroxiv", "aatroxi", "aatroxiv_1",
};
int num[] = {2, 4, 20, 40, 0};

for (int i = 0; i < 5; i++) {
  ck_assert_int_eq(s21_strncmp(str[0], str[i], num[i]),
                   strncmp(str[0], str[i], num[i]));
  printf("***debug --->  s21_strncmp(str[0], str[i], num[i]) = %d, i = %d\n",
         s21_strncmp(str[0], str[i], num[i]), i);
}

#test test_s21_strncpy

char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
int num[] = {2, 4, 20, 30, 0};

for (int i = 0; i < 4; i++) {
  ck_assert_mem_eq(s21_strncpy(str[i], str[i + 1], num[i]),
                   strncpy(str[i], str[i + 1], num[i]), 30);
  printf("***debug --->  s21_strncpy(str[i], str[i+1], num[i]) = %p, i = %d\n",
         s21_strncpy(str[i], str[i + 1], num[i]), i);
}

#test test_s21_strcspn

char str[][30] = {"aatroxiv", "lenwoodr", "_icoricg", "vinephi", "_ivardce"};

for (int i = 0; i < 4; i++) {
  ck_assert_int_eq(s21_strcspn(str[i], str[i + 1]),
                   strcspn(str[i], str[i + 1]));
  printf("***debug --->  s21_strcspn(str[i], str[i+1]) = %d, i = %d\n",
         s21_strcspn(str[i], str[i + 1]), i);
}

#test test_s21_strerror

for (int i = 0; i < 140; i += 14) {
  ck_assert_int_eq(strcmp(s21_strerror(i), strerror(i)), 0);

  printf("***debug --->  s21_strerror(i) = %s, i = %d\n", s21_strerror(i), i);
}

#test test_s21_strlen

char str_array[][20] = {"Privet mir", "Privet \t\n", "\0", "", "Privet \0 MIR"};

for (int i = 0; i < 5; i++) {
  ck_assert_int_eq(s21_strlen(str_array[i]), strlen(str_array[i]));
  printf("***debug --->  s21_strlen(str_array[%d]) %lu\n", i,
         s21_strlen(str_array[i]));
}

#test test_s21_strpbrk

char str[][30] = {"aatroxiv", "lenwoodr", "_icoricg", "vinephi", "aaaaaaa"};

for (int i = 0; i < 4; i++) {
  ck_assert_ptr_eq(s21_strpbrk(str[i], str[i + 1]),
                   strpbrk(str[i], str[i + 1]));
  printf("***debug --->  s21_strpbrk(str[i], str[i+1]) = %p, i = %d\n",
         s21_strpbrk(str[i], str[i + 1]), i);
}

#test test_s21_strrchr

char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
int num[] = {0, 72, 108, 112, 9};

for (int i = 0; i < 5; i++) {
  ck_assert_ptr_eq(s21_strrchr(str[i], num[i]), strrchr(str[i], num[i]));

  printf(
      "***debug --->  s21_strrchr(str[i], num[i]) = %p, i = %d, ch= %c, str = "
      "%s\n",
      s21_strrchr(str[i], num[i]), i, num[i], s21_strrchr(str[i], num[i]));
}

#test test_s21_strstr

char src[] =
    "- Good morning! Help me please! \n joke by aatroxiv, lenwoodr, licoricg, "
    "vinephil, livardce";
char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};

for (int i = 0; i < 5; i++) {
  ck_assert_ptr_eq(s21_strstr(src, str[i]), strstr(src, str[i]));

  printf("***debug --->  s21_strstr(src,str[i]) = %p, i = %d, str = %s\n",
         s21_strstr(src, str[i]), i, s21_strstr(src, str[i]));
}

#test test_s21_strtok

char src[] =
    "- Good morning! Help me please! joke by aatroxiv, lenwoodr, licoricg, "
    "vinephil, livardce";
int length = s21_strlen(src);

char src_1[length + 1], src_2[length + 1];
strcpy(src_1, src);
strcpy(src_2, src);

char delim[] = " ,.-!";

char *res_1 = s21_strtok(src_1, delim);
char *res_2 = strtok(src_2, delim);

while (res_1 && res_2) {
  ck_assert_int_eq(strcmp(res_1, res_2), 0);
  printf(
      "***debug in while --->  s21_strtok(src_1, delim) = %p, res = |%s|\n"
      "***debug in while --->  strtok(src_2, delim) = %p, res = |%s|\n",
      res_1, res_1, res_2, res_2);
  res_1 = s21_strtok(S21_NULL, delim);
  res_2 = strtok(NULL, delim);
}
ck_assert_ptr_eq(res_1, res_2);

printf(
    "***debug --->  s21_strtok(src_1, delim) = %p\n"
    "***debug --->  strtok(src_2, delim) = %p \n",
    res_1, res_2);

res_1 = s21_strtok(S21_NULL, delim);
res_2 = strtok(NULL, delim);
ck_assert_ptr_eq(res_1, res_2);

printf(
    "***debug --->  s21_strtok(src_1, delim) = %p\n"
    "***debug --->  strtok(src_2, delim) = %p \n",
    res_1, res_2);