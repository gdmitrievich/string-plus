#include <stdio.h>
#include <string.h>

#include "s21_string.h"

#test test_s21_memchr

char str[] =
    "- Good morning! Help me please! \0 joke by aatroxiv, lenwoodr, licoricg, "
    "vinephil, livardce \n";
char ch[] = {'-', 'H', 'l', 'p', '\n'};
int num[] = {2, 4, 20, 40, 100};

for (int i = 0; i < 5; i++) {
  ck_assert_ptr_eq(s21_memchr(str, ch[i], num[i]), memchr(str, ch[i], num[i]));

  printf("***debug --->  s21_memchr(str, ch[i], num[i]) = %p, i = %d\n",
         memchr(str, ch[i], num[i]), i);
}

#test test_s21_memcmp

char str[][30] = {
    "aatroxiv", "aatrox1v", "_aatroxiv", "aatroxi", "aatroxiv_1",
};
int num[] = {2, 4, 20, 40, 0};

for (int i = 0; i < 5; i++) {
  ck_assert_int_eq(s21_memcmp(str[0], str[i], num[i]),
                   memcmp(str[0], str[i], num[i]));
  printf("***debug --->  s21_memcmp(str[0], str[i], num[i]) = %d, i = %d\n",
         s21_memcmp(str[0], str[i], num[i]), i);
}

#test test_s21_memcpy

char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
int num[] = {2, 4, 20, 30, 0};

for (int i = 0; i < 4; i++) {
  ck_assert_mem_eq(s21_memcpy(str[i], str[i + 1], num[i]),
                   memcpy(str[i], str[i + 1], num[i]), 30);
  printf("***debug --->  s21_memcpy(str[i], str[i+1], num[i]) = %p, i = %d\n",
         s21_memcpy(str[i], str[i + 1], num[i]), i);
}

#test test_s21_memset

char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
char ch[] = {'-', 'H', 'l', 'p', '\n'};
int num[] = {2, 4, 20, 30, 0};

for (int i = 0; i < 5; i++) {
  ck_assert_mem_eq(s21_memset(str[i], ch[i], num[i]),
                   memset(str[i], ch[i], num[i]), 30);

  printf(
      "***debug --->  s21_memset(str[i], ch[i], num[i]) = %p, i = %d, str = "
      "%s\n",
      s21_memset(str[i], ch[i], num[i]), i, str[i]);
}


#test test_s21_strncat

char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
int num[] = {2, 4, 20, 0, 0};

for (int i = 0; i < 4; i++) {
  ck_assert_mem_eq(s21_strncat(str[i], str[i+1], num[i]),
                   strncat(str[i], str[i+1], num[i]), 30);

  printf(
      "***debug --->  s21_strncat(str[i], str[i+1], num[i]) = %p, i = %d, str = "
      "%s\n",
      s21_strncat(str[i], str[i+1], num[i]), i, str[i]);
}


#test test_s21_strchr

char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
char ch[] = {'\0', 'H', 'l', 'p', '\t'};


for (int i = 0; i < 5; i++) {
  ck_assert_ptr_eq(s21_strchr(str[i], ch[i]),
                   strchr(str[i], ch[i]));

  printf(
      "***debug --->  s21_strchr(str[i], ch[i]) = %p, i = %d, ch= %c, str = %s\n",
      s21_strchr(str[i], ch[i]), i, ch[i], s21_strchr(str[i], ch[i]));
}











#test test_s21_strlen

char str_array[][20] = {"Privet mir", "Privet \t\n", "\0", "", "Privet \0 MIR"};

for (int i = 0; i < 5; i++) {
  ck_assert_int_eq(s21_strlen(str_array[i]), strlen(str_array[i]));
  printf("***debug --->  s21_strlen(str_array[%d]) %lu\n", i,
         s21_strlen(str_array[i]));
}