#include <stdlib.h>

#include "../src/s21_string.h"
#include "../src/s21_string_extra.h"

#test test_s21_memchr

char str[] =
    "- Good morning! Help me please! \0 joke by aatroxiv, lenwoodr, licoricg, "
    "vinephil, livardce \n";
char ch[] = {'-', 'H', 'l', 'p', '\n'};
int num[] = {2, 4, 20, 40, 100};

for (int i = 0; i < 5; i++) {
  ck_assert_ptr_eq(s21_memchr(str, ch[i], num[i]), memchr(str, ch[i], num[i]));
}

#test test_s21_memcmp

char str[][30] = {
    "aatroxiv", "aatrox1v", "_aatroxiv", "aatroxi", "aatroxiv_1",
};
int num[] = {2, 4, 20, 40, 0};

for (int i = 0; i < 5; i++) {
  ck_assert_int_eq(s21_memcmp(str[0], str[i], num[i]),
                   memcmp(str[0], str[i], num[i]));
}

#test test_s21_memcpy

char str_1[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
char str_2[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
int num[] = {2, 4, 20, 30, 0};

for (int i = 0; i < 4; i++) {
  ck_assert_mem_eq(s21_memcpy(str_1[i], str_1[i + 1], num[i]),
                   memcpy(str_2[i], str_2[i + 1], num[i]), 30);
}

#test test_s21_memset

char str_1[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
char str_2[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
char ch[] = {'-', 'H', 'l', 'p', '\n'};
int num[] = {2, 4, 20, 30, 0};

for (int i = 0; i < 5; i++) {
  ck_assert_mem_eq(s21_memset(str_1[i], ch[i], num[i]),
                   memset(str_2[i], ch[i], num[i]), 30);
}

#test test_s21_strncat

char str_1[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
char str_2[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
int num[] = {2, 4, 20, 0, 0};

for (int i = 0; i < 4; i++) {
  ck_assert_mem_eq(s21_strncat(str_1[i], str_1[i + 1], num[i]),
                   strncat(str_2[i], str_2[i + 1], num[i]), 30);
}

#test test_s21_strchr

char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
char ch[] = {'\0', 'H', 'l', 'p', '\t'};

for (int i = 0; i < 5; i++) {
  ck_assert_ptr_eq(s21_strchr(str[i], ch[i]), strchr(str[i], ch[i]));
}

