#test test_s21_strcspn

char str[][30] = {"aatroxiv", "lenwoodr", "_icoricg", "vinephi", "_ivardce"};

for (int i = 0; i < 4; i++) {
  ck_assert_int_eq(s21_strcspn(str[i], str[i + 1]),
                   strcspn(str[i], str[i + 1]));
}

#test test_s21_strerror

for (int i = 0; i < 134; i++) {
  ck_assert_str_eq(s21_strerror(i), strerror(i));
}

#test test_s21_strlen

char str_array[][20] = {"Privet mir", "Privet \t\n", "\0", "", "Privet \0 MIR"};

for (int i = 0; i < 5; i++) {
  ck_assert_int_eq(s21_strlen(str_array[i]), strlen(str_array[i]));
}

#test test_s21_strpbrk

char str[][30] = {"aatroxiv", "lenwoodr", "_icoricg", "vinephi", "aaaaaaa"};

for (int i = 0; i < 4; i++) {
  ck_assert_ptr_eq(s21_strpbrk(str[i], str[i + 1]),
                   strpbrk(str[i], str[i + 1]));
}

#test test_s21_strrchr

char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
int num[] = {0, 72, 108, 112, 9};

for (int i = 0; i < 5; i++) {
  ck_assert_ptr_eq(s21_strrchr(str[i], num[i]), strrchr(str[i], num[i]));
}

#test test_s21_strstr

char src[] =
    "- Good morning! Help me please! \n joke by aatroxiv, lenwoodr, licoricg, "
    "vinephil, livardce";
char str[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};

for (int i = 0; i < 5; i++) {
  ck_assert_ptr_eq(s21_strstr(src, str[i]), strstr(src, str[i]));
}

#test test_s21_strtok

char src[] =
    "- Good morning! Help me please! joke by aatroxiv, lenwoodr, licoricg, "
    "vinephil, livardce";
int length = s21_strlen(src);

char src_1[length + 1], src_2[length + 1];
strcpy(src_1, src);
strcpy(src_2, src);

char delim[] = " ,.-!";

char *res_1 = s21_strtok(src_1, delim);
char *res_2 = strtok(src_2, delim);

while (res_1 && res_2) {
  ck_assert_str_eq(res_1, res_2);
  res_1 = s21_strtok(S21_NULL, delim);
  res_2 = strtok(NULL, delim);
}
ck_assert_ptr_eq(res_1, res_2);

res_1 = s21_strtok(S21_NULL, delim);
res_2 = strtok(NULL, delim);
ck_assert_ptr_eq(res_1, res_2);

#test test_s21_to_upper

char src_1[] = "qwertyuiopasdfghjklzxcvbnm[];',./";
char src_2[] =
    " !\"#$%&'()*+,-./"
    "0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`"
    "abcdefghijklmnopqrstuvwxyz{|}~";

char expected_1[] = "QWERTYUIOPASDFGHJKLZXCVBNM[];',./";
char expected_2[] =
    " !\"#$%&'()*+,-./"
    "0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`"
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ{|}~";

char *str_after_s21_to_upper_1 = s21_to_upper(src_1);

if (str_after_s21_to_upper_1) {
  ck_assert_str_eq(expected_1, str_after_s21_to_upper_1);
  free(str_after_s21_to_upper_1);
}

char *str_after_s21_to_upper_2 = s21_to_upper(src_2);
if (str_after_s21_to_upper_2) {
  ck_assert_str_eq(expected_2, str_after_s21_to_upper_2);
  free(str_after_s21_to_upper_2);
}

#test test_s21_to_lower

char src_1[] = "QWERTYUIOPASDFGHJKLZXCVBNM[];',./";
char src_2[] =
    " !\"#$%&'()*+,-./"
    "0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`"
    "abcdefghijklmnopqrstuvwxyz{|}~";

char expected_1[] = "qwertyuiopasdfghjklzxcvbnm[];',./";
char expected_2[] =
    " !\"#$%&'()*+,-./"
    "0123456789:;<=>?@abcdefghijklmnopqrstuvwxyz[]^_`"
    "abcdefghijklmnopqrstuvwxyz{|}~";

char *str_after_s21_to_lower_1 = s21_to_lower(src_1);
if (str_after_s21_to_lower_1) {
  ck_assert_str_eq(expected_1, str_after_s21_to_lower_1);
  free(str_after_s21_to_lower_1);
}

char *str_after_s21_to_lower_2 = s21_to_lower(src_2);
if (str_after_s21_to_lower_2) {
  ck_assert_str_eq(expected_2, str_after_s21_to_lower_2);
  free(str_after_s21_to_lower_2);
}

#test test_s21_insert

char *src_1 = "aatroxiv, lenwoodr, licoricg, vinephil, livardce";
char *src_2 = "Insert into __ here!";

char *str_1 = "Hello! It is ";
char *str_2 = "OK";

char *expected_1 =
    "Hello! It is aatroxiv, lenwoodr, licoricg, vinephil, livardce";
char *expected_2 = "Insert into _OK_ here!";

char *res_1 = s21_insert(src_1, str_1, 0);

if (res_1) {
  ck_assert_str_eq(res_1, expected_1);
  free(res_1);
}

char *res_2 = s21_insert(src_2, str_2, 13);

if (res_2) {
  ck_assert_str_eq(res_2, expected_2);
  free(res_2);
}
