char str[][30] = {
    "aatroxiv", "aatrox1v", "_aatroxiv", "aatroxi", "aatroxiv_1",
};
int num[] = {2, 4, 20, 40, 0};

for (int i = 0; i < 5; i++) {
  ck_assert_int_eq(s21_strncmp(str[0], str[i], num[i]),
