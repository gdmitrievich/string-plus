#test test_s21_strncpy

char str_1[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
char str_2[][30] = {"aatroxiv", "lenwoodr", "licoricg", "vinephil", "livardce"};
int num[] = {2, 4, 20, 30, 0};

for (int i = 0; i < 4; i++) {
  ck_assert_mem_eq(s21_strncpy(str_1[i], str_1[i + 1], num[i]),
